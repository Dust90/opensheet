{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@opensheet/shared": ["../../packages/shared/src/index.ts"],
      "@opensheet/core": ["../../packages/core/src/index.ts"],
      "@opensheet/commands": ["../../packages/commands/src/index.ts"],
      "@opensheet/history": ["../../packages/history/src/index.ts"],
      "@opensheet/plugin-api": ["../../packages/plugin-api/src/index.ts"],
      "@opensheet/runtime": ["../../packages/runtime/src/index.ts"]
    },

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
