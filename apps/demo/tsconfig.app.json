{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@injoysai/opensheet-shared": ["../../packages/shared/src/index.ts"],
      "@injoysai/opensheet-core": ["../../packages/core/src/index.ts"],
      "@injoysai/opensheet-commands": ["../../packages/commands/src/index.ts"],
      "@injoysai/opensheet-history": ["../../packages/history/src/index.ts"],
      "@injoysai/opensheet-import-export": ["../../packages/import-export/src/index.ts"],
      "@injoysai/opensheet-plugin-api": ["../../packages/plugin-api/src/index.ts"],
      "@injoysai/opensheet-formula-engine": ["../../packages/formula-engine/src/index.ts"],
      "@injoysai/opensheet-renderer-canvas": ["../../packages/renderer-canvas/src/index.ts"],
      "@injoysai/opensheet": ["../../packages/runtime/src/index.ts"]
    },

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
