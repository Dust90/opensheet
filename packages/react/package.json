{
  "name": "@injoysai/opensheet-react",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "dependencies": {
    "@injoysai/opensheet-shared": "workspace:*",
    "@injoysai/opensheet-renderer-canvas": "workspace:*",
    "@injoysai/opensheet-plugin-api": "workspace:*",
    "@injoysai/opensheet": "workspace:*"
  }
}
