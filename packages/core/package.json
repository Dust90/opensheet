{
  "name": "@injoysai/opensheet-core",
  "version": "0.1.0-next.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dust90/opensheet.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./dist/index.js",
