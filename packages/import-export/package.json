{
  "name": "@injoysai/opensheet-import-export",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./csv.worker.js": {
      "types": "./dist/csv.worker.d.ts",
      "import": "./dist/csv.worker.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/csv.worker.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@injoysai/opensheet-shared": "workspace:*"
  }
}
