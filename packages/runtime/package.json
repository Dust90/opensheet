{
  "name": "@injoysai/opensheet",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dust90/opensheet.git",
    "directory": "packages/runtime"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@injoysai/opensheet-commands": "workspace:*",
    "@injoysai/opensheet-core": "workspace:*",
    "@injoysai/opensheet-history": "workspace:*",
    "@injoysai/opensheet-plugin-api": "workspace:*",
    "@injoysai/opensheet-shared": "workspace:*",
    "@injoysai/opensheet-formula-engine": "workspace:*",
    "@injoysai/opensheet-import-export": "workspace:*"
  }
}
