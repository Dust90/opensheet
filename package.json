{
  "name": "opensheet",
  "version": "0.1.0",
  "description": "A standalone high-performance web spreadsheet engine",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dust90/opensheet.git"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "pnpm --filter @injoysai/opensheet-demo dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "bench:cell-store": "node scripts/bench-cell-store.mjs",
    "bench:grid": "node scripts/bench-grid.mjs",
    "bench:filter": "node scripts/bench-filter.mjs",
    "bench:formula": "node scripts/bench-formula.mjs",
    "bench:find": "node scripts/bench-find.mjs",
    "bench:csv": "node scripts/bench-csv.mjs",
    "bench:dedupe": "pnpm exec playwright test -c playwright.perf.config.ts m4-dedupe.perf.spec.ts",
    "bench:sort": "pnpm exec playwright test -c playwright.perf.config.ts m4-sort.perf.spec.ts",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "licenses:check": "node scripts/licenses-check.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "spreadsheet",
    "canvas",
    "grid",
    "typescript"
  ],
  "author": "OpenSheet Contributors",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.10",
    "fast-check": "^4.1.1",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10",
    "yaml": "^2.8.0"
  }
}
